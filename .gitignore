# Byte-compiled / optimized files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Environment variables
.env
.env.*

# Python packaging
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# Type checkers
.mypy_cache/
.pyre/
.pytype/

# Linters
.ruff_cache/

# IDEs
.vscode/
.idea/

# macOS
.DS_Store

# Windows
Thumbs.db

# Jupyter
.ipynb_checkpoints/

# Logs
*.log
# ...except sample logs used by tests and the README
!app.log
!samples/*.log
!tests/fixtures/*.log

# Runtime files
*.pid
*.out
*.err

# Local model/cache directories (optional)
models/
cache/

# Ollama (if storing local model configs)
ollama.log

# Temporary files
*.tmp
*.temp
